#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define SCROLL 5
#define NUM 6

#undef ZMK_POINTING_DEFAULT_SCRL_VAL

#define ZMK_POINTING_DEFAULT_SCRL_VAL 140

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <180>;
    quick-tap-ms = <150>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <0>;
    require-prior-idle-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        lang1 {
            bindings = <&toLayer0_lang1>;
            key-positions = <18 19>;
            timeout-ms = <30>;
        };

        lang2 {
            bindings = <&toLayer0_lang2>;
            key-positions = <19 20>;
            timeout-ms = <30>;
        };

        window_right {
            bindings = <&kp LC(RIGHT_ARROW)>;
            key-positions = <12 13>;
        };

        window_left {
            bindings = <&kp LC(LEFT_ARROW)>;
            key-positions = <12 11>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
        };

        question {
            bindings = <&kp SLASH>;
            key-positions = <31 32>;
        };

        under {
            bindings = <&myUnder>;
            key-positions = <30 31>;
        };

        sana {
            bindings = <&kp LA(SPACE)>;
            key-positions = <24 23>;
        };

        raycast {
            bindings = <&Raycast>;
            key-positions = <8 7>;
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        paste {
            bindings = <&kp LG(LC(V))>;
            key-positions = <1 2>;
        };
    };

    behaviors {
        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            /* 20ms から 12ms 程度へ短縮して連射速度を上げます */

            tap-ms = <20>;
        };

        z_mt: z_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "Z_MOD_TAP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;

            /* require-prior-idle-ms は付けない。
               直前に打鍵があるとホールド判定自体が走らず、
               タイピング中の Shift が効かなくなるため。
               誤ホールドは flavor=tap-preferred と
               tapping-term-ms=200 で防ぐ。 */

            bindings = <&kp>, <&kp>;
        };

        /* Aキー用の設定を追加 */

        a_mt: a_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "A_MOD_TAP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        spc_lt: spc_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_LAYER_TAP";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        window_slide: window_slide {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LA(LC(LG(RIGHT_ARROW)))>,
                <&macro_wait_time 50>,
                <&kp LA(LC(RET))>;

            label = "WINDOW_SLIDE";
        };

        window_slide2: window_slide2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LA(LC(LG(LEFT_ARROW)))>,
                <&macro_wait_time 50>,
                <&kp LC(LA(UP_ARROW))>;

            label = "WINDOW_SLIDE2";
        };

        myComma: myComma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2>, <&macro_wait_time 15>, <&kp COMMA>;

            label = "MYCOMMA";
        };

        myUnder: myUnder {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2>, <&macro_wait_time 15>, <&kp UNDER>;

            label = "MYUNDER";
        };

        myKakko1: myKakko1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS>;
            label = "MYKAKKO1";
        };

        myKakko2: myKakko2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET>;
            label = "MYKAKKO2";
        };

        myKakko3: myKakkko3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOUBLE_QUOTES &kp DOUBLE_QUOTES>;
            label = "MYKAKKKO3";
        };

        alt_tab_stay: alt_tab_stay {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "ALT_TAB_STAY";
        };

        Raycast: Raycast {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT &kp LEFT_GUI>,
                <&macro_tap>,
                <&kp SPACE>,
                <&macro_release>,
                <&kp LEFT_ALT &kp LEFT_GUI>;

            label = "RAYCAST";
        };

        toLayer0_lang1: toLayer0_lang1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LANG1>;
            label = "TOLAYER0_LANG1";
        };

        toLayer0_lang2: toLayer0_lang2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LANG2>;
            label = "TOLAYER0_LANG2";
        };

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q               &kp W  &kp E      &kp R         &kp T                                      &kp Y            &kp U  &kp I    &kp O      &kp P
&a_mt LCTRL A       &kp S  &kp D      &lt 2 F       &lt 7 G       &kp K_MUTE      &mo 6        &kp H            &kp J  &lt 5 K  &kp L      &kp RET
&z_mt LEFT_SHIFT Z  &kp X  &kp C      &kp V         &kp B         &kp F20         &mo 4        &kp SEMICOLON    &kp N  &kp M    &kp COMMA  &mt RSHIFT PERIOD
&kp LEFT_SHIFT      &mo 4  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &kp SPACE       &lt 2 MINUS  &spc_lt 3 SPACE                             &kp ESCAPE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &trans  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &trans
            >;
        };

        NUM {
            bindings = <
&kp EXCL              &kp AT                &kp HASH              &kp LG(LS(N4))        &kp LG(LS(N5))                                                      &kp KP_MULTIPLY  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_EQUAL
&kp CARET             &kp DOUBLE_QUOTES     &kp PERCENT           &kp AMPERSAND         &kp SINGLE_QUOTE      &trans                 &kp LEFT_PARENTHESIS   &kp KP_PLUS      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_SLASH
&kp LA(LG(NUMBER_1))  &kp LA(LG(NUMBER_2))  &kp LA(LG(NUMBER_3))  &kp LA(LG(NUMBER_4))  &kp LA(LG(NUMBER_6))  &kp LEFT_BRACKET       &kp RIGHT_PARENTHESIS  &kp KP_MINUS     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD
&trans                &trans                &trans                &trans                &trans                &kp RIGHT_BRACKET      &myComma               &kp KP_NUMBER_0                                                     &trans
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE         &kp LG(NUMBER_2)      &kp LG(NUMBER_3)      &kp LG(NUMBER_7)      &kp LG(LS(LEFT_BRACKET))                                   &kp LA(LC(RET))  &kp LA(LC(UP_ARROW))    &kp UP_ARROW    &kp LG(NUMBER_0)         &kp BACKSPACE
&kp TAB            &kp LG(LA(NUMBER_2))  &kp LG(LA(NUMBER_3))  &kp LG(LA(NUMBER_7))  &kp LG(LS(RIGHT_BRACKET))  &trans          &window_slide2  &kp LG(EQUAL)    &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp LS(SEMI)
&kp LC(LA(LG(F)))  &trans                &kp LA(LC(LG(C)))     &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)      &kp LG(N5)      &window_slide   &kp LG(MINUS)    &kp LA(LC(LEFT_ARROW))  &kp LA(LC(R))   &kp LA(LC(RIGHT_ARROW))  &kp SEMI
&trans             &trans                &trans                &trans                &trans                     &trans          &trans          &trans                                                                            &trans
            >;

            sensor-bindings = <&inc_dec_kp LEFT_BRACKET RIGHT_BRACKET>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &kp F11  &kp F12                      &kp F17  &kp F18  &kp F19  &kp F20  &kp TILDE
&trans  &trans  &trans  &trans   &trans   &trans      &trans  &trans   &trans   &trans   &trans   &trans
&trans  &trans  &trans  &trans   &trans   &trans      &trans  &trans   &trans   &trans   &trans   &trans
&trans  &trans  &trans  &trans   &trans   &trans      &trans  &trans                              &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                  &bt BT_CLR_ALL
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp RIGHT_BRACKET      &kp TILDE
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp DOUBLE_QUOTES     &trans                 &trans                 &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                                      &trans
            >;
        };
    };
};
